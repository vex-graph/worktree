#!/bin/sh
# tools/b — Vexgraph entry point: the workspace b bootstrap.
#
# This workspace uses b (vex/b) as its only build runner. CMake is IDE metadata
# only (colors, inlay hints, debug symbols); it creates no runnables.
#
# Commands:
#   b generate                     claim the territory, write .b/workspace.json
#   b build                        compile every source the territory lists
#   b build <unit-or-source>       compile and link one unit
#   b run                          build and run the unit in this directory
#   b run -- <args...>             the same, forwarding arguments to the unit
#   b run <file> [args...]         build or interpret one file
#
# b.sh owns the bootstrap: it rebuilds b when its own sources are newer, then
# execs the binary from $B_HOME. Preserve the caller's directory — a unit build
# resolves its manifest against the working directory.
set -eu

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
root=$(CDPATH= cd -- "$here/.." && pwd)
bootstrap="$root/vex/b/b.sh"

if [ ! -f "$bootstrap" ]; then
    echo "tools/b: error: b bootstrap not found at $bootstrap" >&2
    exit 1
fi

export B_CALLER_DIR="${B_CALLER_DIR:-$PWD}"
export B_WORKSPACE_ROOT="${B_WORKSPACE_ROOT:-$root}"
export B_INCLUDE="$root/lib"
exec "$bootstrap" "$@"
