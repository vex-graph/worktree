#!/bin/sh
# tools/b — Vexgraph entry point: directly launches the 'b' build engine.
#
# This workspace uses generic b (from vex-graph/b) as its
# build system and package coordinator. It does NOT delegate to tools/workspace.c.
#
# Commands (see vexgraph-hobby-projects/b/README.md):
#   b workspace [<dir>] [--as <name>]
#   b build [<target>...] [--in <name>]
#   b breeze <source> [args...]
#   b run <source> [args...]
#   b box [<action>]
#   b adapter <name> [args...]
set -eu

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
root=$(CDPATH= cd -- "$here/.." && pwd)
binary="$root/vexgraph-hobby-projects/b/b"

if [ ! -f "$binary" ]; then
    echo "tools/b: error: 'b' launcher not found at $binary" >&2
    exit 1
fi

export B_CALLER_DIR="${B_CALLER_DIR:-$PWD}"
export B_HOME="${B_HOME:-$HOME/Library/Application Support/b}"

exec "$binary" "$@"
