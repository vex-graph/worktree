#!/bin/sh
# tools/b — launcher for the build system defined in tools/b.c ("a lowkey nob") because thats tsoding's branding >w<.
#
# The compiled binary AND all build state live OUTSIDE the source tree, under
# Application Support (override the location with $B_HOME):
#
#   ~/Library/Application Support/vexgraph/b/
#     b            the compiled build binary
#     out/ deps/ meta/ cache/ logs/
#
# The source tree keeps only tools/b.c (plus a git-ignored b.json).
set -e
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
root=$(CDPATH= cd -- "$here/.." && pwd)
state="${B_HOME:-$HOME/Library/Application Support/vexgraph/b}"
bin="$state/b"
mkdir -p "$state"
if [ ! -x "$bin" ] || [ "$here/b.c" -nt "$bin" ]; then
    cc -std=gnu23 -O2 -Wall -Wextra "$here/b.c" -o "$bin"
fi
cd "$root"
exec "$bin" "$@"
